{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "./**/*.ts",
    "./**/*.svelte",
    "../src/shared/**/*.ts",
    "../src/core/breaks.ts",
    "../src/core/stats.ts"
  ]
}